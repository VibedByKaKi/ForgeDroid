ded0aee5a25cc","html_url":"https://codeberg.org/earl-warren","language":"","is_admin":false,"last_login":"0001-01-01T00:00:00Z","created":"2022-11-26T18:56:24+01:00","restricted":false,"active":false,"prohibit_login":false,"location":"","pronouns":"","website":"","description":"","visibility":"public","followers_count":50,"following_count":2,"starred_repos_count":28,"username":"earl-warren"},"body":"","created_at":"2023-07-24T10:46:37+02:00","updated_at":"2023-07-24T10:46:37+02:00","old_project_id":0,"project_id":0,"old_milestone":null,"milestone":null,"tracked_time":null,"old_title":"","new_title":"","old_ref":"","new_ref":"","ref_issue":{"id":325253,"url":"https://codeberg.org/api/v1/repos/forgejo/forgejo/issues/824","html_url":"https://codeberg.org/forgejo/forgejo/issues/824","number":824,"user":{"id":73579,"login":"earl-warren","login_name":"","source_id":0,"full_name":"Earl Warren","email":"earl-warren@noreply.codeberg.org","avatar_url":"https://codeberg.org/avatars/baa02ddebf727ef06a0ded0aee5a25cc","html_url":"https://codeberg.org/earl-warren","language":"","is_admin":false,"last_login":"0001-01-01T00:00:00Z","created":"2022-11-26T18:56:24+01:00","restricted":false,"active":false,"prohibit_login":false,"location":"","pronouns":"","website":"","description":"","visibility":"public","followers_count":50,"following_count":2,"starred_repos_count":28,"username":"earl-warren"},"original_author":"","original_author_id":0,"title":"Identifying regressions v1.20","body":"A curated lists of things to watch for that may indicate regressions (functional or UI) in Forgejo v1.20 release candidates.\n\n## Reported\n\n* Can't publish new package versions anymore https://github.com/go-gitea/gitea/issues/26646\n* Some endpoints ignore specified account and use auth account instead https://github.com/go-gitea/gitea/issues/26234\n* LDAP \"Admin Filter\" stopped working https://github.com/go-gitea/gitea/issues/25985\n* Gitea container register ask auth for all users except Administrators on public registry https://github.com/go-gitea/gitea/issues/25908\n* Member of team owner cannot create a new repository when also member of a non privileged team via LDAP https://github.com/go-gitea/gitea/issues/26338 \n\n## Confirmed\n\n### Other\n\n* Download release asset using api key no longer working https://github.com/go-gitea/gitea/issues/26165#issuecomment-1652125943 \u0026\u0026 https://github.com/go-gitea/gitea/pull/26175 \u0026\u0026 https://github.com/go-gitea/gitea/pull/26428\n* Cannot access private repo release files through API using bearer token anymore  https://github.com/go-gitea/gitea/issues/25257#issuecomment-1711723794 \u0026 https://github.com/go-gitea/gitea/pull/26430\n* Add transaction when creating pull request created dirty data https://codeberg.org/forgejo/forgejo/issues/1249 \u0026\u0026 https://github.com/go-gitea/gitea/pull/26259\n\n## Fixed in v1.20.3-0\n\n* Number of repositories includes the number of private repositories in profile page https://github.com/go-gitea/gitea/issues/25914 \u0026\u0026 https://github.com/go-gitea/gitea/pull/25928\n* Storage in S3 buckets using minio not working in Gitea 1.20.0 with working config from Gitea 1.19.4 https://github.com/go-gitea/gitea/issues/25984 \u0026 https://github.com/go-gitea/gitea/pull/26420\n* Uploading files to a web page will cause the repository instance to crash https://github.com/go-gitea/gitea/issues/26509 \u0026 https://github.com/go-gitea/gitea/pull/26560\n* [storage*] behavior change https://codeberg.org/forgejo/forgejo/pulls/1225\n* 1.20.2: hang when branch protections enable \"Dismiss stale approvals\" https://github.com/go-gitea/gitea/issues/26280 \u0026 https://github.com/go-gitea/gitea/pull/26305\n* Unable to deliver webhook task[53215]: webhook does not exist [id: 134] https://github.com/go-gitea/gitea/issues/25744#issuecomment-1656793914 (this was dealt with as downgraded from error to warning but the root cause is not determined)\n* Stats.DB Index Repo[425] hangs https://github.com/go-gitea/gitea/issues/26064 \u0026 https://github.com/go-gitea/gitea/pull/26325\n* Storage paths can be incorrectly set https://github.com/go-gitea/gitea/issues/26264 \u0026\u0026 https://github.com/go-gitea/gitea/pull/26271 \u0026\u0026 https://github.com/go-gitea/gitea/pull/26318\n\n## Fixed in v1.20.2-0\n\n* CreateUser, visibility Mode not allowed: public https://github.com/go-gitea/gitea/issues/25951 https://github.com/go-gitea/gitea/pull/26206\n* **MSSQL specific** Migrate failure 1.19.3 =\u003e 1.20.0: Change Container Metadata failed https://github.com/go-gitea/gitea/issues/25918 https://github.com/go-gitea/gitea/pull/26199\n* Git LFS - Garbage collect LFS meta objects error https://github.com/go-gitea/gitea/issues/26093\n* 404 when branch name contains # https://github.com/go-gitea/gitea/issues/26088\n\n## Fixed in v1.20.1-0\n\n* Allow all URL schemes in Markdown links by default https://github.com/go-gitea/gitea/pull/24805 \u0026\u0026 https://github.com/go-gitea/gitea/pull/25960\n* Fix env config parsing for \"GITEA____APP_NAME\" https://github.com/go-gitea/gitea/pull/26001\n* /api/v1/version should not give 403 for authenticated users/tokens  https://github.com/go-gitea/gitea/issues/26035 https://codeberg.org/forgejo/forgejo/pulls/1100\n* Upgrade from 1.20.0-rc0 to 1.20.0 fails: Deprecated fallback present https://codeberg.org/forgejo/forgejo/issues/1081\n* SSPI auth error after update to 1.20.0 https://github.com/go-gitea/gitea/issues/25952 \u0026\u0026 https://github.com/go-gitea/gitea/pull/25955\n* gitea --help fails https://github.com/go-gitea/gitea/issues/25938 \u0026\u0026 https://github.com/go-gitea/gitea/pull/25944\n* environment-to-ini does not work with INSTALL_LOCK https://github.com/go-gitea/gitea/issues/25924 \u0026\u0026 https://github.com/go-gitea/gitea/pull/25926\n* [Webhook create events return incorrect ref_type](https://github.com/go-gitea/gitea/issues/25185) breaks Woodpecker\n* [Toggling checkbox in task list corrupts markdown when there's YAML front matter](https://github.com/go-gitea/gitea/issues/25160)\n* Pull requests page author filter doesn't work https://github.com/go-gitea/gitea/issues/25906 \u0026\u0026 https://github.com/go-gitea/gitea/pull/26018","ref":"","assets":[],"labels":[{"id":79185,"name":"Discussion","exclusive":false,"is_archived":false,"color":"5319e7","description":"","url":"https://codeberg.org/api/v1/repos/forgejo/forgejo/labels/79185"}],"milestone":{"id":4378,"title":"Forgejo v1.20.4-0","description":"","state":"closed","open_issues":0,"closed_issues":15,"created_at":"2023-08-12T09:13:47+02:00","updated_at":"2023-09-09T21:02:56+02:00","closed_at":"2023-09-09T21:02:56+02:00","due_on":"2023-09-11T01:59:59+02:00"},"assignee":null,"assignees":null,"state":"closed","is_locked":false,"comments":41,"created_at":"2023-06-09T07:54:12+02:00","updated_at":"2023-12-25T18:07:54+01:00","closed_at":"2023-09-08T07:52:24+02:00","due_date":null,"pull_request":null,"repository":{"id":73144,"name":"forgejo","owner":"forgejo","full_name":"forgejo/forgejo"},"pin_order":0},"ref_comment":null,"ref_action":"none","ref_commit_sha":"","review_id":0,"label":null,"assignee":null,"assignee_team":null,"removed_assignee":false,"resolve_doer":null,"dependent_issue":null}]
