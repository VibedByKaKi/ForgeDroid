w .tar.gz\r\nDownload BUNDLE\r\nClone in VS Code\r\n```","created_at":"2023-06-23T08:21:43+02:00","updated_at":"2023-06-23T08:21:43+02:00","old_project_id":0,"project_id":0,"old_milestone":null,"milestone":null,"tracked_time":null,"old_title":"","new_title":"","old_ref":"","new_ref":"","ref_issue":null,"ref_comment":null,"ref_action":"none","ref_commit_sha":"","review_id":0,"label":null,"assignee":null,"assignee_team":null,"removed_assignee":false,"resolve_doer":null,"dependent_issue":null},{"id":2028287,"type":"label","html_url":"https://codeberg.org/forgejo/forgejo/issues/800#issuecomment-2028287","pull_request_url":"","issue_url":"https://codeberg.org/forgejo/forgejo/issues/800","user":{"id":73579,"login":"earl-warren","login_name":"","source_id":0,"full_name":"Earl Warren","email":"earl-warren@noreply.codeberg.org","avatar_url":"https://codeberg.org/avatars/baa02ddebf727ef06a0ded0aee5a25cc","html_url":"https://codeberg.org/earl-warren","language":"","is_admin":false,"last_login":"0001-01-01T00:00:00Z","created":"2022-11-26T18:56:24+01:00","restricted":false,"active":false,"prohibit_login":false,"location":"","pronouns":"","website":"","description":"","visibility":"public","followers_count":50,"following_count":2,"starred_repos_count":28,"username":"earl-warren"},"body":"1","created_at":"2024-06-17T03:49:28+02:00","updated_at":"2024-06-17T03:49:28+02:00","old_project_id":0,"project_id":0,"old_milestone":null,"milestone":null,"tracked_time":null,"old_title":"","new_title":"","old_ref":"","new_ref":"","ref_issue":null,"ref_comment":null,"ref_action":"none","ref_commit_sha":"","review_id":0,"label":{"id":201023,"name":"bug/confirmed","exclusive":true,"is_archived":false,"color":"e11d21","description":"it can be reproduced","url":"https://codeberg.org/api/v1/repos/forgejo/forgejo/labels/201023"},"assignee":null,"assignee_team":null,"removed_assignee":false,"resolve_doer":null,"dependent_issue":null},{"id":2028344,"type":"label","html_url":"https://codeberg.org/forge