os_count":44,"username":"mahlzahn"},"body":"","created_at":"2026-08-31T22:40:57+02:00","updated_at":"2026-08-31T22:40:57+02:00","old_project_id":0,"project_id":0,"old_milestone":null,"milestone":null,"tracked_time":null,"old_title":"","new_title":"","old_ref":"","new_ref":"","ref_issue":{"id":6978601,"url":"https://codeberg.org/api/v1/repos/Codeberg/Community/issues/3052","html_url":"https://codeberg.org/Codeberg/Community/issues/3052","number":3052,"user":{"id":1248134,"login":"t36s","login_name":"","source_id":0,"full_name":"","email":"t36s@noreply.codeberg.org","avatar_url":"https://codeberg.org/avatars/c96ce569a3a7d4766255554d1b68d633d67174395f3567629ac207243e587995","html_url":"https://codeberg.org/t36s","language":"","is_admin":false,"last_login":"0001-01-01T00:00:00Z","created":"2026-06-19T11:28:00+02:00","restricted":false,"active":false,"prohibit_login":false,"location":"","pronouns":"","website":"","description":"","visibility":"public","followers_count":2,"following_count":0,"starred_repos_count":1,"username":"t36s"},"original_author":"","original_author_id":0,"title":"All lower case folder name after repo .zip download from codeberg.org","body":"### Comment\n\nHi.\r\nLove the site.\r\nTiny hiccup with the site though ( not when cloning the a repo in the terminal).\r\nWhen someone downloads the .zip of a repo using the three dots (more operations, download ZIP) the resultant folder is the repo name in all lower case.\r\nThe repo in question is a SuperCollider extension and requires CamelCasing in order to be recognized by SuperCollider. \r\nThe all lower case name change results in an error when users follow SuperClean installation instructions.\r\nI love that you made it so the repo folder does not have a -Main slapped on the end like how it was in the bad old days on GitHub.\r\nI am happy to be here and I hope that I have provided enough information to make it possible to understand what I mean, if not, please let me know and I will do my best to clarify.\n\n","ref":"","assets":[],"labels":[{"id":102,"name":"bug","exclusive":false,"is_archived":false,"color":"ee0701","description":"Something is not working the way it should. Does not concern outages.","url":"https://codeberg.org/api/v1/repos/Codeberg/Community/labels/102"},{"id":338,"name":"s/Forgejo","exclusive":false,"is_archived":false,"color":"eb6420","description":"Related to Forgejo. Please also check Forgejo's issue tracker.","url":"https://codeberg.org/api/v1/repos/Codeberg/Community/labels/338"},{"id":11356,"name":"upstream","exclusive":false,"is_archived":false,"color":"0052cc","description":"An open issue or pull request to an upstream repository to fix this issue (partially or completely) exists (i.e. Forgejo, Weblate, etc.)","url":"https://codeberg.org/api/v1/repos/Codeberg/Community/labels/11356"}],"milestone":null,"assignee":null,"assignees":null,"state":"closed","is_locked":false,"comments":1,"created_at":"2026-08-31T18:29:13+02:00","updated_at":"2026-09-15T09:33:32+02:00","closed_at":"2026-08-31T22:40:57+02:00","due_date":null,"pull_request":null,"repository":{"id":1,"name":"Community","owner":"Codeberg","full_name":"Codeberg/Community"},"pin_order":0},"ref_comment":{"id":22082011,"html_url":"https://codeberg.org/Codeberg/Community/issues/3052#issuecomment-22082011","pull_request_url":"","issue_url":"https://codeberg.org/Codeberg/Community/issues/3052","user":{"id":55597,"login":"mahlzahn","login_name":"","source_id":0,"full_name":"Robert Wolff","email":"mahlzahn@noreply.codeberg.org","avatar_url":"https://codeberg.org/avatars/38aaf335c256be75baad14a954801bfeb7aea344f7dadc3e699a683f535fab6a","html_url":"https://codeberg.org/mahlzahn","language":"","is_admin":false,"last_login":"0001-01-01T00:00:00Z","created":"2022-07-01T18:07:29+02:00","restricted":false,"active":false,"prohibit_login":false,"location":"","pronouns":"","website":"","description":"[⁂](https://symbol.fediverse.info) \u003ca rel=\"me\" href=\"https://nerdculture.de/@mahlzahn\"\u003e